<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent cho daemon vn-esign (macOS).
    cp packaging/macos/com.vn-esign.service.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.vn-esign.service.plist
  Chỉnh ProgramArguments theo nơi cài (khuyến nghị bản universal2).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.vn-esign.service</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/vn-esign-service</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/tmp/vn-esign.out.log</string>
    <key>StandardErrorPath</key><string>/tmp/vn-esign.err.log</string>
  </dict>
</plist>
